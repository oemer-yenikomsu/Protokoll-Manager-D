@echo off
title Protokoll-Manager - Beispiel START (Produktion)
cd /d "%~dp0backend"

if not exist "venv\Scripts\activate.bat" (
    echo Python-Umgebung fehlt. Bitte zuerst INSTALL.bat ausfuehren.
    pause
    exit /b 1
)

if not exist "..\frontend\dist\index.html" (
    echo Frontend nicht gebaut. Bitte BUILD-FRONTEND.bat ausfuehren.
    pause
    exit /b 1
)

call venv\Scripts\activate.bat

REM Demo-SECRET_KEY nur fuer lokale Tests – in echtem Betrieb eigenen Wert setzen!
set SECRET_KEY=portfolio-demo-secret-change-before-deploy

python run_production.py
pause
